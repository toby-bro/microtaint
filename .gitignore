paper

bench.c
bench.elf
cellift.txt
build_maat.sh
debug*.py
input
plot_*.py
verify_patches.py
*demo*.py
sleigh-translate.py
bench_kernel.py
# Derived artifacts that kept showing up as untracked noise.
# Profiler dumps: regenerable, and cProfile output in particular is misleading
# for this codebase (it cannot see Cython cdef / C frames -- use perf).
*.prof
*.elf

# Baseline engines are third-party checkouts, not ours to vendor: Pin alone is
# ~600k lines and needs a licence accepted by hand.  setup_envs.sh fetches
# them; the repository must not carry them.
**/external/pin-*/
**/external/libdft64/
**/external/taintgrind/
# Vendored third-party engines for the RQ2 comparison (Pin, libdft64,
# TaintGrind).  Fetched by the artifact setup script, never committed.
artifacts/ndss27/*/external/

# The performance suite writes these; the baseline lives in the CI cache.
.bench_current.json
.bench_baseline.json
benchmark/taint_density/hookcost

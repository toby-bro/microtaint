# mypy
.mypy_cache/

*.json
# ...except the results that ARE the record: a ratchet baseline says what
# performance and op counts were, and a benchmark result says what the engine
# cost on a given day.  Both have to be versioned with the code that produced
# them, or they sit on disk drifting from it with nothing to say how old they
# are -- which is exactly what happened to the two below.
!tests/perf_baseline.json
!tests/perop_op_baseline.json
!tests/taint_ir_perf_baseline.json
# ...and the artifact's committed results, which ARE the evidence a
# reviewer compares their run against.
!artifacts/ndss27/**/*.json
shadow.c
__init__.c
categories.c
ast_test.c
microtaint/instrumentation/ast.c
microtaint/instrumentation/cell.c
microtaint/emulator/hook_core.c


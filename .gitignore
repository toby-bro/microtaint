# Baseline engines are third-party checkouts, not ours to vendor: Pin alone is
# ~600k lines and needs a licence accepted by hand.  setup_envs.sh fetches
# them; the repository must not carry them.
**/external/pin-*/
**/external/libdft64/
**/external/taintgrind/

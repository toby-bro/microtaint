# What in this tree is produced by a machine rather than written by hand.
#
# `linguist-generated` does two useful things on GitHub: the file is collapsed
# in a diff, so a pull request that regenerates a 700 KB campaign JSON does not
# bury its three lines of real change, and the file is left out of the language
# statistics, so the repository stops describing itself by the size of its
# measurement output.
#
# Only files that a command reproduces are marked.  Hand-written README and .sh
# files living beside generated data are deliberately NOT marked, because their
# diffs are the ones worth reading.
#
# Note there is no `* text=auto` here on purpose.  Introducing it would
# renormalise line endings across the whole history's worth of files in one
# commit, which is a large diff for no benefit in a tree that is only ever
# built on Linux and macOS.

# ── Lockfile ────────────────────────────────────────────────────────────────
# Resolved by `uv lock`.  Reviewed for WHICH packages moved, never line by line.
uv.lock                                     linguist-generated=true

# ── The instruction bank ────────────────────────────────────────────────────
# ~1,500 verified-sound instruction forms, assembled to raw bytes by build.py
# so downstream consumers need no keystone.  The .jsonl is the output; build.py
# beside it is the source and stays reviewable.
benchmark/instruction_bank/instructions.jsonl        linguist-generated=true
scripts/sweep/pinned/instruction_bank/instructions.jsonl  linguist-generated=true

# The pinned timing harness is a byte-exact snapshot whose MANIFEST.sha256
# proves it has not moved.  Marking the manifest generated keeps a
# re-snapshot's hash churn out of the diff; the snapshot's own .py files are
# left alone, since a change to one of those is exactly what the manifest
# exists to make visible.
scripts/sweep/pinned/MANIFEST.sha256         linguist-generated=true

# ── Performance baselines ───────────────────────────────────────────────────
# Regenerated by UPDATE_PERF_BASELINE=1 pytest tests/test_perf_ratchet.py.
tests/perf_baseline.json                     linguist-generated=true

# ── Archived measurement runs ───────────────────────────────────────────────
# artifacts/ndss27/reference-runs/ holds the output of real evaluation runs:
# per-experiment JSON, harness logs, and the paper's generated tables, macros
# and figures.  All of it is produced by run-all.sh and the gen_*.py scripts.
#
# Matched by extension rather than by directory, so that README.md and the
# setup .sh in those directories keep ordinary diffs.
artifacts/ndss27/reference-runs/**/*.json    linguist-generated=true
artifacts/ndss27/reference-runs/**/*.jsonl   linguist-generated=true
artifacts/ndss27/reference-runs/**/*.txt     linguist-generated=true
artifacts/ndss27/reference-runs/**/*.tex     linguist-generated=true

# Generated markdown, named individually.  A blanket **/*.md here would also
# catch reference-runs/README.md, which is hand-written documentation and whose
# diff is one of the ones worth reading -- the exact mistake the comment at the
# top of this block warns against.
artifacts/ndss27/reference-runs/**/SUMMARY.md     linguist-generated=true

# The generated tables and macros elsewhere under artifacts/, from
# gen_eval_tables.py, gen_apps_tables.py, gen_ladder_table.py and
# gen_paper_macros.py.
artifacts/ndss27/**/*_tables.tex             linguist-generated=true
artifacts/ndss27/**/*_tables.md              linguist-generated=true
artifacts/ndss27/**/*_numbers.tex            linguist-generated=true
artifacts/ndss27/**/table5.tex               linguist-generated=true
artifacts/ndss27/**/ladder_table.*           linguist-generated=true

# ── Binary artefacts ────────────────────────────────────────────────────────
# `binary` is -text -diff: git stops trying to find lines in them and never
# offers a textual merge, which for a 1.2 MB xz or a compiled ELF is the only
# sensible answer.
*.tar.xz                                     binary linguist-generated=true
*.pdf                                        binary linguist-generated=true

# A pre-built static guest, committed because the Windows and macOS CI runners
# have no compiler that emits a Linux ELF.  tests/guests/smoke_amd64.c beside
# it is the source, and a test rebuilds from it wherever a toolchain can.
tests/guests/*.guest                         binary linguist-generated=true

# ── Vendored third-party source ─────────────────────────────────────────────
# Upstream SipHash reference implementation (Aumasson, Bernstein), used as the
# avalanche workload.  Not ours to restyle, and it should not count towards the
# repository's own language statistics.
artifacts/ndss27/avalanche/siphash/siphash_ref.c  linguist-vendored=true

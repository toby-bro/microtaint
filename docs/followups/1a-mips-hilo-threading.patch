+def _cross_instruction_intermediate_regs(  # noqa: C901
+    translation: object,
+    ctx: object,
+) -> tuple[tuple[str, int], ...]:
+    """Registers written by one sub-instruction and read by a later one.
+
+    When a multi-instruction sequence is split into per-instruction sub-circuits
+    (see generate_static_rule), taint that flows through a register BETWEEN steps
+    is threaded by the ChainedCircuit only for registers named in the sub-circuit
+    state_format.  Anything else -- MIPS's HI/LO after ``mult;mflo``, a scratch
+    register updated by step N and read by step N+1 -- is silently dropped,
+    under-tainting the later step.  This finds every such intermediate so the
+    caller can add it to the sub-circuit state_format.  It subsumes (and
+    generalises across ISAs) the former x86-flags-only augmentation: on x86 it
+    returns exactly the flags a following instruction consumes.
+    """
+    ops = translation.ops  # type: ignore[attr-defined]
+    ordinal: list[int] = []
+    ins = -1
+    for op in ops:
+        if op.opcode.name == 'IMARK':
+            ins += 1
+        ordinal.append(ins)
+    writes: list[tuple[int, int, int]] = []
+    reads: list[tuple[int, int, int]] = []
+    for i, op in enumerate(ops):
+        for vn in op.inputs:
+            if vn.space.name == 'register':
+                reads.append((vn.offset, vn.offset + vn.size, ordinal[i]))
+        if op.output is not None and op.output.space.name == 'register':
+            writes.append((op.output.offset, op.output.offset + op.output.size, ordinal[i]))
+    ranges: set[tuple[int, int]] = set()
+    for wlo, whi, wins in writes:
+        for rlo, rhi, rins in reads:
+            if rins > wins and wlo < rhi and rlo < whi:  # overlap, read strictly later
+                ranges.add((max(wlo, rlo), min(whi, rhi)))
+    # Resolve each byte range to the smallest register that fully contains it.
+    # Only WIDE registers (>= 2 bytes) are threaded here: those are the multi-byte
+    # intermediates the caller's state_format cannot express by another name
+    # (MIPS HI/LO, a widening multiply's high half).  Single-byte registers are
+    # deliberately excluded -- an ISA's 1-byte status flags (x86 CF/OF/ZF/... are
+    # byte registers in SLEIGH, not bits) are threaded at their true 1-bit width by
+    # the x86 flag safety net in the caller, and a 1-byte GPR sub-view is already
+    # covered by its parent in the state_format.  Threading a byte flag here as an
+    # 8-bit register mismatched the engine's 1-bit flag convention.
+    out: dict[str, int] = {}
+    regs = ctx.registers  # type: ignore[attr-defined]
+    for lo, hi in ranges:
+        best: tuple[str, int] | None = None
+        for nm, vn in regs.items():
+            if vn.space.name == 'register' and vn.offset <= lo and hi <= vn.offset + vn.size:
+                if best is None or vn.size < best[1]:
+                    best = (nm, vn.size)
+        if best is not None and best[1] >= 2:
+            out[best[0]] = best[1] * 8
+    return tuple(sorted(out.items()))
+
